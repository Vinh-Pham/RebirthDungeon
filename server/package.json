{
  "name": "rebirth-dungeon-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "node tools/migrate-local.mjs",
    "db:check:remote": "node tools/check-remote.mjs",
    "db:migrate:remote": "node tools/migrate-remote.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test test/migrations.test.mjs test/seed.test.mjs test/queues.integration.test.mjs test/online-tools.test.mjs test/admin-roles.test.mjs && node --import tsx --test test/email-command.test.mjs",
    "test:watch": "vitest",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir dist",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "db:baseline:local": "node tools/migrate-local.mjs --baseline",
    "test:smoke": "node tools/smoke-local.mjs",
    "test:migrations": "node --test test/migrations.test.mjs",
    "email:dev": "email dev --dir src/email/templates --port 3000",
    "email:test": "tsx tools/email-test.ts",
    "build": "wrangler deploy --dry-run --outdir dist",
    "db:migrate": "node tools/migrate-local.mjs",
    "db:seed": "node tools/seed-local.mjs",
    "db:seed:local": "node tools/seed-local.mjs",
    "db:setup": "node tools/migrate-local.mjs && node tools/seed-local.mjs",
    "test:seed": "node --test test/seed.test.mjs",
    "admin:roles": "node tools/admin-roles.mjs"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.7",
    "@better-auth/expo": "1.7.7",
    "@hono/zod-openapi": "^1.6.3",
    "@rebirth/game-core": "workspace:*",
    "@scalar/hono-api-reference": "^0.12.5",
    "better-auth": "1.7.7",
    "drizzle-orm": "1.0.0-rc.4",
    "hono": "^4.13.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-email": "6.11.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.2.6",
    "@cloudflare/workers-types": "^5.20260924.1",
    "@react-email/ui": "6.11.0",
    "@types/node": "^26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "^18.0.3",
    "drizzle-kit": "1.0.0-rc.4",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.85.0",
    "tsx": "4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.110.0"
  },
  "packageManager": "pnpm@12.6.0"
}
