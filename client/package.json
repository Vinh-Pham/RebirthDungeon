{
    "name": "client",
    "version": "1.1.0",
    "description": "A dice-driven fantasy RPG",
    "keywords": [
        "phaser",
        "phaser3",
        "react",
        "typescript",
        "vite"
    ],
    "homepage": "https://github.com/phaserjs/template-react-ts#readme",
    "bugs": {
        "url": "https://github.com/phaserjs/template-react-ts/issues"
    },
    "license": "MIT",
    "author": "Phaser Studio <support@phaser.io> (https://phaser.io/)",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/phaserjs/template-react-ts.git"
    },
    "scripts": {
        "dev": "vite --config vite/config.dev.mjs",
        "build": "vite build --config vite/config.prod.mjs",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:e2e": "playwright test",
        "test:coverage": "vitest run --coverage",
        "dev-nolog": "vite --config vite/config.dev.mjs",
        "build-nolog": "vite build --config vite/config.prod.mjs",
        "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build && pnpm test:e2e",
        "format": "oxfmt .",
        "format:check": "oxfmt --check .",
        "lint": "oxlint --deny-warnings --report-unused-disable-directives",
        "lint:fix": "oxlint --fix --deny-warnings --report-unused-disable-directives"
    },
    "dependencies": {
        "@dnd-kit/react": "^0.5.0",
        "@heroui-pro/react": "1.0.0-beta.10",
        "@heroui/react": "^3.2.6",
        "@heroui/styles": "^3.2.6",
        "@react-aria/interactions": "^3.28.1",
        "@react-aria/utils": "^3.34.1",
        "@surdeddd/wmkit": "0.11.1",
        "immer": "^11.1.18",
        "motion": "^13.4.0",
        "phaser": "4.2.1",
        "phaser4-rex-plugins": "^4.2.0",
        "playwright": "^1.63.0",
        "react": "^19.3.0",
        "react-aria": "^3.52.1",
        "react-aria-components": "^1.21.1",
        "react-dom": "^19.3.0",
        "react-hotkeys-hook": "^5.3.3",
        "react-resizable-panels": "^4.12.4",
        "react-stately": "^3.50.0",
        "tailwind-merge": "^3.7.0",
        "tailwind-variants": "^3.3.1",
        "tailwindcss": "^4.3.3",
        "vitest": "^5.0.1",
        "xstate": "^5.33.2"
    },
    "devDependencies": {
        "@playwright/test": "^1.63.0",
        "@tailwindcss/vite": "^4.3.3",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.1",
        "@vitest/coverage-v8": "^5.0.1",
        "fake-indexeddb": "^6.2.5",
        "jsdom": "^30.1.0",
        "terser": "^5.51.2",
        "typescript": "~7.0.2",
        "vite": "^8.3.0"
    },
    "licenseUrl": "http://www.opensource.org/licenses/mit-license.php"
}