{
  "name": "@rebirth/game-core",
  "private": true,
  "type": "module",
  "exports": {
    "./data/*.json": "./src/data/*.json",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
