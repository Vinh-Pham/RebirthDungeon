    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.85.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@12.6.0"
}
