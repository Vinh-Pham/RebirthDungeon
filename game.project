[project]
title = Rebirth Dungeon
version = 0.1.0
custom_resources = /game/data,/tests/fixtures,/game/integrations/third_party_licenses.txt
dependencies#0 = https://github.com/defold/extension-automation-bridge/archive/941fc93f8b9eb6fa81ca9d70df892ed0ad689d0c.zip
dependencies#1 = https://github.com/masakazu-k/defold-aseprite-scripts/archive/48776fad7b607677a1740e7fe6152ba4726277ad.zip
dependencies#2 = https://github.com/britzl/deftest/archive/a75fedc71dce2f7129126501c31f5d10c1815bac.zip
dependencies#3 = https://github.com/Pause-Games/flow/archive/20250e81c483715e09f935ff10b1c7138796a880.zip
dependencies#4 = https://codeload.github.com/Insality/defold-event/zip/384813497c25ff41d34ab1efdb1163217dc9dd26
dependencies#5 = https://github.com/abadonna/defold-ink/archive/5e871c42f645689e7263d85015fab2b2f2743907.zip
dependencies#6 = https://github.com/britzl/monarch/archive/5c33c39830489925493163e741d5b22b4e5e3b9d.zip
dependencies#7 = https://github.com/britzl/defold-richtext/archive/bacbc0c369724c0133827d85a9ac76f7439afc23.zip
dependencies#8 = https://github.com/Insality/decore/archive/d430ac6b37ad09b4b0bffc0b2d4cad663c98bda6.zip
dependencies#9 = https://github.com/Insality/defold-saver/archive/36bdd1fc90da9175eb19a01948c02d157f45134e.zip

[bootstrap]
main_collection = /main/main.collectionc

[input]
game_binding = /builtins/input/all.input_bindingc

[display]
width = 1280
height = 720

[graphics]
max_characters = 16384
default_texture_min_filter = nearest
default_texture_mag_filter = nearest
max_font_batches = 4096
max_draw_calls = 4096

[script]
shared_state = 1

[automation_bridge]
application_api = 1

[collection]
max_instances = 2048

[gui]
max_count = 32
max_particlefx_count = 0
