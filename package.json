{
  "name": "rebirth-dungeon",
  "version": "1.0.0",
  "description": "A keyboard-first science-fantasy roguelike",
  "scripts": {
    "assets": "node tools/web/pack-assets.mjs",
    "dev": "pnpm assets && vite",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt --write src tests tools index.html package.json tsconfig.json vite.config.ts",
    "format:check": "oxfmt --check src tests tools index.html package.json tsconfig.json vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "pnpm assets && pnpm typecheck && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@heroui-pro/react": "^1.0.1",
    "@heroui/react": "^3.2.8",
    "@heroui/styles": "^3.2.8",
    "@pixi/react": "8.0.5",
    "@pixi/tilemap": "5.0.2",
    "@react-aria/utils": "^3.34.1",
    "@surdeddd/wmkit": "0.15.0",
    "alea": "1.0.1",
    "dexie": "4.4.7",
    "gsap": "3.15.1",
    "inkjs": "2.4.0",
    "miniplex": "2.0.0",
    "motion": "^14.14.0",
    "pixi-viewport": "7.0.3",
    "pixi.js": "8.23.0",
    "react": "^19.3.1",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1",
    "react-dnd": "16.0.1",
    "react-dnd-html5-backend": "16.0.1",
    "react-dom": "^19.3.1",
    "react-hotkeys-hook": "5.4.0",
    "react-resizable-panels": "^4.24.2",
    "react-stately": "^3.51.0",
    "rot-js": "2.2.1",
    "simplex-noise": "4.0.3",
    "tailwind-merge": "^3.7.1",
    "tailwind-variants": "^4.0.2",
    "tailwindcss": "^4.3.5",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "^24.19.4",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "fake-indexeddb": "6.2.8",
    "fast-check": "4.11.0",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.2"
  },
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": "^24.0.0 || >=26.0.0"
  }
}
