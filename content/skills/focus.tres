[gd_resource type="Resource" format=3]
[ext_resource type="Script" path="res://scripts/data/definitions/skill_definition.gd" id="script"]
[ext_resource type="Texture2D" path="res://assets/art/dungeon_mark.svg" id="icon"]
[ext_resource type="Script" path="res://scripts/data/definitions/skill_rank.gd" id="rank"]
[sub_resource type="Resource" id="F"]
script = ExtResource("rank")
mp_cost = 3
duration = 3

[resource]
script = ExtResource("script")
id = "skill.focus"
display_name = "focus"
icon = ExtResource("icon")
effect = "stat_buff"
target = "self"
status_id = "status.focused"
ranks = Array[ExtResource("rank")]([SubResource("F")])
