[resource]
script = ExtResource("script")
content_version = 3
combinations = Array[ExtResource("combo")]([SubResource("combo0"), SubResource("combo1"), SubResource("combo2"), SubResource("combo3"), SubResource("combo4"), SubResource("combo5"), SubResource("combo6"), SubResource("combo7")])
actors = Array[ExtResource("actors_type")]([ExtResource("actors_hero"), ExtResource("actors_training_enemy")])
skills = Array[ExtResource("skills_type")]([ExtResource("skills_sword"), ExtResource("skills_fortify"), ExtResource("skills_enemy_strike"), ExtResource("skills_focus"), ExtResource("skills_spark"), ExtResource("skills_blood")])
stats = Array[ExtResource("stats_type")]([ExtResource("stats_strength"), ExtResource("stats_defense"), ExtResource("stats_magic_attack"), ExtResource("stats_magic_defense"), ExtResource("stats_protection"), ExtResource("stats_magic_protection")])
statuses = Array[ExtResource("statuses_type")]([ExtResource("statuses_fortified"), ExtResource("statuses_weakened"), ExtResource("statuses_focused")])
items = Array[ExtResource("items_type")]([ExtResource("items_training_sword"), ExtResource("items_potion"), ExtResource("items_field_bag"), ExtResource("items_gold_bag"), ExtResource("items_iron_sword"), ExtResource("items_great_sword"), ExtResource("items_shield"), ExtResource("items_armor"), ExtResource("items_spark_book"), ExtResource("items_focus_notes"), ExtResource("items_focus_page_one"), ExtResource("items_focus_page_two"), ExtResource("items_focus_book"), ExtResource("items_lantern_coupon")])
encounters = Array[ExtResource("encounters_type")]([ExtResource("encounters_training"), ExtResource("encounters_gallery"), ExtResource("encounters_sanctum")])
rooms = Array[ExtResource("rooms_type")]([ExtResource("rooms_training"), ExtResource("rooms_haven"), ExtResource("rooms_threshold"), ExtResource("rooms_gallery"), ExtResource("rooms_sanctum")])
