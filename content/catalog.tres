[gd_resource type="Resource" script_class="CatalogManifest" format=3]

[ext_resource type="Script" path="res://scripts/data/definitions/catalog_manifest.gd" id="script"]
[ext_resource type="Script" path="res://scripts/data/definitions/combination_definition.gd" id="combo"]
[ext_resource type="Script" path="res://scripts/data/definitions/actor_definition.gd" id="actors_type"]
[ext_resource type="Resource" path="res://content/actors/hero.tres" id="actors_hero"]
[ext_resource type="Resource" path="res://content/actors/training_enemy.tres" id="actors_training_enemy"]
[ext_resource type="Script" path="res://scripts/data/definitions/skill_definition.gd" id="skills_type"]
[ext_resource type="Resource" path="res://content/skills/sword.tres" id="skills_sword"]
[ext_resource type="Resource" path="res://content/skills/fortify.tres" id="skills_fortify"]
[ext_resource type="Resource" path="res://content/skills/enemy_strike.tres" id="skills_enemy_strike"]
[ext_resource type="Script" path="res://scripts/data/definitions/stat_definition.gd" id="stats_type"]
[ext_resource type="Resource" path="res://content/stats/strength.tres" id="stats_strength"]
[ext_resource type="Resource" path="res://content/stats/defense.tres" id="stats_defense"]
[ext_resource type="Script" path="res://scripts/data/definitions/status_definition.gd" id="statuses_type"]
[ext_resource type="Resource" path="res://content/statuses/fortified.tres" id="statuses_fortified"]
[ext_resource type="Resource" path="res://content/statuses/weakened.tres" id="statuses_weakened"]
[ext_resource type="Script" path="res://scripts/data/definitions/item_definition.gd" id="items_type"]
[ext_resource type="Resource" path="res://content/items/training_sword.tres" id="items_training_sword"]
[ext_resource type="Script" path="res://scripts/data/definitions/encounter_definition.gd" id="encounters_type"]
[ext_resource type="Resource" path="res://content/encounters/training.tres" id="encounters_training"]
[ext_resource type="Script" path="res://scripts/data/definitions/room_definition.gd" id="rooms_type"]
[ext_resource type="Resource" path="res://content/rooms/training.tres" id="rooms_training"]

[sub_resource type="Resource" id="combo0"]
script = ExtResource("combo")
key = "none"
numerator = 1
denominator = 1

[sub_resource type="Resource" id="combo1"]
script = ExtResource("combo")
key = "pair"
numerator = 3
denominator = 2

[sub_resource type="Resource" id="combo2"]
script = ExtResource("combo")
key = "two_pairs"
numerator = 2
denominator = 1

[sub_resource type="Resource" id="combo3"]
script = ExtResource("combo")
key = "three_kind"
numerator = 5
denominator = 2

[sub_resource type="Resource" id="combo4"]
script = ExtResource("combo")
key = "straight"
numerator = 3
denominator = 1

[sub_resource type="Resource" id="combo5"]
script = ExtResource("combo")
key = "full_house"
numerator = 7
denominator = 2

[sub_resource type="Resource" id="combo6"]
script = ExtResource("combo")
key = "four_kind"
numerator = 5
denominator = 1

[sub_resource type="Resource" id="combo7"]
script = ExtResource("combo")
key = "five_kind"
numerator = 10
denominator = 1

[resource]
script = ExtResource("script")
combinations = Array[ExtResource("combo")]([SubResource("combo0"), SubResource("combo1"), SubResource("combo2"), SubResource("combo3"), SubResource("combo4"), SubResource("combo5"), SubResource("combo6"), SubResource("combo7")])
actors = Array[ExtResource("actors_type")]([ExtResource("actors_hero"), ExtResource("actors_training_enemy")])
skills = Array[ExtResource("skills_type")]([ExtResource("skills_sword"), ExtResource("skills_fortify"), ExtResource("skills_enemy_strike")])
stats = Array[ExtResource("stats_type")]([ExtResource("stats_strength"), ExtResource("stats_defense")])
statuses = Array[ExtResource("statuses_type")]([ExtResource("statuses_fortified"), ExtResource("statuses_weakened")])
items = Array[ExtResource("items_type")]([ExtResource("items_training_sword")])
encounters = Array[ExtResource("encounters_type")]([ExtResource("encounters_training")])
rooms = Array[ExtResource("rooms_type")]([ExtResource("rooms_training")])
