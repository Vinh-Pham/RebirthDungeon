[gd_resource type="BehaviorTree" format=3 uid="uid://deevcscnetcx7"]

[ext_resource type="Script" uid="uid://baihe21dmkvp2" path="res://scripts/combat_intent_task.gd" id="1_intent"]

[sub_resource type="BTAction" id="BTAction_defend"]
custom_name = "Prepare Defend"
script = ExtResource("1_intent")

[sub_resource type="BTAction" id="BTAction_attack"]
custom_name = "Prepare Attack"
script = ExtResource("1_intent")
phase = 1
chosen_intent = 0

[sub_resource type="BTAction" id="BTAction_smash"]
custom_name = "Prepare Smash"
script = ExtResource("1_intent")
phase = 2
chosen_intent = 2

[sub_resource type="BTAction" id="BTAction_fallback"]
custom_name = "Defensive Monster"
script = ExtResource("1_intent")
defensive_fallback = true

[sub_resource type="BTSelector" id="BTSelector_intent"]
children = [SubResource("BTAction_defend"), SubResource("BTAction_attack"), SubResource("BTAction_smash"), SubResource("BTAction_fallback")]

[resource]
description = "Select the next combat intent when a monster finishes its current action."
root_task = SubResource("BTSelector_intent")
