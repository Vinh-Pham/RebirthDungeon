@tool
extends RefCounted

## playtest op=export_gd (v1.16): a saved suite as a standalone GDScript test. The test replays the suite's
## recorded input (or runs its steps flow) in a plain `godot --headless --script` run, judges every assert and
## per-frame rule that needs nothing but the running game, and exits 0 (pass), 1 (fail) or 2 (blocked). It needs
## no editor, no MCP server and nothing from addons/beckett, so a CI job can run a suite an agent verified, with
## the addon switched off or not installed. (The 64ix/godot-playtest project freezes agent sessions into plain
## GDScript the same way.)
##
## The test itself is playtest_standalone.gd: a real, parse-checked script whose helpers mirror the editor-side
## ones. This module only fills it in: a header (what the file is and how to run it), and one data block, the
## suite's events, steps, asserts and rules as GDScript literals. Everything it embeds goes through lit() and
## quote(): a string is escaped character by character (a quote, a backslash, a newline, a control character, a
## lone surrogate), so a node path, an expression or a value from a suite file can never leave its literal and
## become code; anything placed in a comment goes through comment_text(), which cannot start a new line.
##
## Pure data in, data out, so the unit suite pins it without a game or a disk: build() returns the file's text.
## The tool (playtest_tools.gd) does the I/O. Full-only like the tool; pack.ps1 trims this module and the
## template from Lite.

const PathGuard := preload("res://addons/beckett/core/path_guard.gd")

const TEMPLATE_PATH := "res://addons/beckett/tools/playtest_standalone.gd"
const MARK_HEADER := "# @@HEADER@@"
const MARK_BEGIN := "# @@DATA-BEGIN@@"
const MARK_END := "# @@DATA-END@@"
## The first words of every file this module writes. An existing file that does not start with them is not ours,
## and the tool refuses to overwrite it.
const GENERATED_MARK := "# Generated by Beckett playtest op=export_gd"
const DEFAULT_DIR := "res://tests/beckett"
const EVENT_TYPES := ["key", "action", "mouse_button", "mouse_motion", "joy_button", "joy_axis", "touch", "touch_drag"]
const STEP_KINDS := ["click", "type", "wait", "assert", "input", "inject", "state"]
const RUN_ASSERTS := ["node_state", "screen_text", "expr"]
const NOT_RUN_ASSERTS := {
	"screenshot": "needs a rendered frame; a headless CI run has none (playtest op=run in the editor runs it)",
	"perf": "perf is measured in the editor's replay window, and a render-less CI loop has no frame cost to bound (playtest op=run runs it)",
	"no_overlap": "it asks the physics engine through Beckett's own physics query, which a test that needs no Beckett does not carry (playtest op=run and the headless runner run it)",
}
const COMMENT_MAX := 160



## res://tests/beckett/<suite>_test.gd, for a suite name that is already a safe file stem.
static func default_path(pname: String) -> String:
	return "%s/%s_test.gd" % [DEFAULT_DIR, pname]


## "" when `path` is somewhere the test may be written, else why not. A .gd file inside the project, and nowhere
## core/path_guard.gd refuses (outside the project, "..", a control character, a link that leaves the project).
static func path_error(path: String) -> String:
	if not path.begins_with("res://"):
		return "path must start with res:// (the test runs as part of the project: godot --path <project> --script res://...)"
	if not path.ends_with(".gd") or path.get_file().get_basename().is_empty():
		return "path must be a .gd file name, e.g. %s" % default_path("my_suite")
	return PathGuard.write_path_error(path)



## The test file for a suite document: {source, mode, counts, not_run, notes} or {error}.
## opts: settle_frames (extra frames after the last event before the asserts, default 4: what op=run uses), path
## (where it will be written: only for the header's run command), source (the suite file), beckett (a version).
## The finished source is compiled once by the engine (see parse_error), so a file the tool writes is one this
## Godot loads, whatever the suite held.
static func build(doc: Dictionary, opts: Dictionary = {}) -> Dictionary:
	var template := FileAccess.get_file_as_string(TEMPLATE_PATH)
	if template.is_empty():
		return {"error": "the standalone template %s is missing or empty: the addon is half installed" % TEMPLATE_PATH}
	return build_from(template, doc, opts)


## "" when `source` compiles as a GDScript on this engine, else a sentence saying it does not. Nothing runs: the
## script is only loaded (reload() parses and compiles it, and the engine prints the line and the reason to its
## log). Escaping every string is what keeps a suite's text from breaking the file, and this is the check that does
## not rest on that being right (GDScript refuses characters the escaping once let through, and a later engine may
## refuse more). About 60 ms for the template.
static func parse_error(source: String) -> String:
	var probe := GDScript.new()
	probe.source_code = source
	var err := probe.reload()
	if err == OK:
		return ""
	return "the generated test does not compile on this Godot (%s), so nothing was written. The engine's log (the Output panel) names the line and the reason. This is a bug in the exporter or a character in the suite it did not escape: please report it, with the suite file" % error_string(err)


## build() with the template text given (the unit suite damages it on purpose).
static func build_from(template: String, doc: Dictionary, opts: Dictionary = {}) -> Dictionary:
	var events_in: Array = doc.get("events", []) if doc.get("events", []) is Array else []
	var steps_in: Array = doc.get("steps", []) if doc.get("steps", []) is Array else []
	var pname := str(doc.get("name", "suite"))
	if events_in.is_empty() and steps_in.is_empty():
		return {"error": "suite '%s' has no events and no steps: there is nothing to replay" % comment_text(pname, 60)}
	var scene := str(doc.get("scene", ""))
	if scene.is_empty():
		return {"error": "suite '%s' names no scene, and a standalone test has to load one: save the suite again with scene=res://... (op=save scene=...)" % comment_text(pname, 60)}
	if not (scene.begins_with("res://") or scene.begins_with("user://")) or scene.contains("..") or scene.length() > 400:
		return {"error": "suite '%s' names the scene '%s', which is not a scene of this project (res:// or user://, no '..'): fix the suite before it is exported" % [comment_text(pname, 60), comment_text(scene, 100)]}
	var mode := "steps" if not steps_in.is_empty() else "events"
	var not_run: Array = []
	var notes: Array = []

	var events: Array = []
	if mode == "events":
		for i in events_in.size():
			var e: Variant = events_in[i]
			if not (e is Dictionary):
				not_run.append({"where": "events[%d]" % i, "kind": "event", "why": "not an object: left out"})
				continue
			events.append(e)
			if not EVENT_TYPES.has(str((e as Dictionary).get("type", ""))):
				not_run.append({"where": "events[%d]" % i, "kind": comment_text(str((e as Dictionary).get("type", "")), 40), "why": "unknown event type: skipped, as the editor's replay skips it"})
		var stamped := false
		for e in events:
			if (e as Dictionary).has("f"):
				stamped = true
				break
		if not stamped:
			notes.append("the events carry no frame stamps (recorded before Beckett 1.8): all of them go in on the first frame, as op=run's back-to-back fallback does; re-record for a frame-exact replay")

	var asserts: Array = doc.get("asserts", []) if doc.get("asserts", []) is Array else []
	for i in asserts.size():
		var a: Variant = asserts[i]
		if not (a is Dictionary):
			not_run.append({"where": "asserts[%d]" % i, "kind": "assert", "why": "not an object: skipped"})
			continue
		var kind := str((a as Dictionary).get("type", "")).to_lower()
		if RUN_ASSERTS.has(kind):
			continue
		if NOT_RUN_ASSERTS.has(kind):
			not_run.append({"where": "asserts[%d]" % i, "kind": kind, "why": str(NOT_RUN_ASSERTS[kind])})
		else:
			not_run.append({"where": "asserts[%d]" % i, "kind": comment_text(kind, 40), "why": "unknown assert type: skipped"})

	var uses_ui := false
	if mode == "steps":
		for i in steps_in.size():
			var s: Variant = steps_in[i]
			if not (s is Dictionary):
				not_run.append({"where": "steps[%d]" % i, "kind": "step", "why": "not an object: the test fails the flow there"})
				continue
			var k := step_kind(s)
			if k.is_empty():
				not_run.append({"where": "steps[%d]" % i, "kind": "step", "why": "unknown step kind (the standalone test runs %s): the test fails the flow there, as the editor's run does" % ", ".join(PackedStringArray(STEP_KINDS))})
			elif k == "click" or k == "type":
				uses_ui = true
	if uses_ui:
		notes.append("click and type push real input into the viewport, but unlike the editor's they do not check that the control is uncovered or on screen, or scroll it into view")

	var settle := maxi(0, int(opts.get("settle_frames", 4)))
	var step_timeout := maxi(100, int(doc.get("step_timeout_ms", 5000)))
	var counts := {"events": events.size(), "steps": steps_in.size() if mode == "steps" else 0, "asserts": asserts.size(),
		"invariants": (doc.get("invariants", []) as Array).size() if doc.get("invariants", []) is Array else 0}

	var data := PackedStringArray()
	data.append("# ---- the suite (generated; every string below is escaped, none can become code) ----")
	data.append("const SUITE := %s" % quote(pname))
	data.append("const SCENE := %s" % quote(scene))
	data.append("const MODE := %s" % quote(mode))
	data.append("const SETTLE_FRAMES := %d" % settle)
	data.append("const STEP_TIMEOUT_MS := %d" % step_timeout)
	data.append_array(const_array("EVENTS", events if mode == "events" else []))
	data.append_array(const_array("STEPS", steps_in if mode == "steps" else []))
	data.append_array(const_array("ASSERTS", asserts))
	var invariants: Variant = doc.get("invariants", [])
	data.append_array(const_array("INVARIANTS", invariants if invariants is Array else []))
	var spliced := splice(template, header_text(doc, opts, mode, counts, not_run, notes), "\n".join(data))
	if spliced.has("error"):
		return spliced
	var bad := parse_error(str(spliced["source"]))
	if not bad.is_empty():
		return {"error": bad}
	return {"source": str(spliced["source"]), "mode": mode, "counts": counts, "not_run": not_run, "notes": notes}


## Which of the step kinds a step is, "" when it is none of them. The flat spelling {kind: "inject" | "state"} counts.
static func step_kind(step: Variant) -> String:
	if not (step is Dictionary):
		return ""
	var d: Dictionary = step
	for k in ["click", "type", "wait", "assert", "input"]:
		if d.has(k):
			return k
	for k in ["inject", "state"]:
		if d.has(k) or str(d.get("kind", "")) == k:
			return k
	return ""


## `const NAME: Array = [` + one element per line + `]`, or the one-line empty form.
static func const_array(const_name: String, items: Array) -> PackedStringArray:
	var out := PackedStringArray()
	if items.is_empty():
		out.append("const %s: Array = []" % const_name)
		return out
	out.append("const %s: Array = [" % const_name)
	for it in items:
		out.append("\t%s," % lit(it))
	out.append("]")
	return out


## The header: a comment block that opens the file. The first line is GENERATED_MARK (the overwrite check reads it).
static func header_text(doc: Dictionary, opts: Dictionary, mode: String, counts: Dictionary, not_run: Array, notes: Array) -> String:
	var pname := comment_text(str(doc.get("name", "suite")), 60)
	var path := str(opts.get("path", ""))
	var shown_path := comment_text(path if not path.is_empty() else default_path(pname), COMMENT_MAX)
	var what := ("a steps suite of %d steps" % int(counts["steps"])) if mode == "steps" else ("an events suite of %d events" % int(counts["events"]))
	var lines := PackedStringArray()
	lines.append("%s. Do not edit it: export again after the suite changes." % GENERATED_MARK)
	lines.append("#")
	lines.append("# Suite:   %s, %s, %d asserts, %d invariants" % [pname, what, int(counts["asserts"]), int(counts["invariants"])])
	lines.append("# Scene:   %s" % comment_text(str(doc.get("scene", "")), COMMENT_MAX))
	if not str(opts.get("source", "")).is_empty():
		lines.append("# Source:  %s (schema %d)" % [comment_text(str(opts["source"]), COMMENT_MAX), int(doc.get("schema_version", 1))])
	if not str(opts.get("beckett", "")).is_empty():
		lines.append("# Beckett: %s" % comment_text(str(opts["beckett"]), 40))
	lines.append("#")
	lines.append("# Run it with no editor and no Beckett (the addon may be switched off or not installed):")
	lines.append("#   godot --headless --path <project folder> --script %s" % shown_path)
	lines.append("# Exit code: 0 pass, 1 fail, 2 blocked (nothing failed, but something could not be judged: the scene or a")
	lines.append("# node is missing, or the game quit before the suite was judged). Every judgement prints one line, and the last")
	lines.append("# line starts with BECKETT_RESULT.")
	if mode == "events":
		lines.append("# The replay runs at the physics rate, so a run takes about as long as the recording. Add --fixed-fps <the")
		lines.append("# project's physics rate, 60 unless you changed it> to run it as fast as the machine allows: the physics frames the")
		lines.append("# events are stamped on are the same, but logic keyed to the wall clock or to _process's delta sees another clock.")
	else:
		lines.append("# A steps flow runs in real time: each step is tried once per frame, under its own timeout.")
	for n in notes:
		lines.append("# Note: %s." % comment_text(str(n), 400))
	lines.append("#")
	if not_run.is_empty():
		lines.append("# Nothing was left out: every assert, rule and step of the suite runs here.")
	else:
		lines.append("# NOT RUN here (listed so nothing is dropped silently; playtest op=run in the editor runs what it can):")
		for r in not_run:
			lines.append("#   %s %s: %s" % [comment_text(str((r as Dictionary)["where"]), 40), comment_text(str((r as Dictionary)["kind"]), 40), comment_text(str((r as Dictionary)["why"]), 300)])
	return "\n".join(lines)


## The template with its header line and its data block replaced. {source} or {error}.
static func splice(template: String, header: String, data: String) -> Dictionary:
	var lines := template.replace("\r\n", "\n").split("\n")
	var at_header := -1
	var at_begin := -1
	var at_end := -1
	for i in lines.size():
		var l := lines[i].strip_edges()
		if l == MARK_HEADER and at_header == -1:
			at_header = i
		elif l == MARK_BEGIN and at_begin == -1:
			at_begin = i
		elif l == MARK_END and at_end == -1:
			at_end = i
	if at_header != 0 or at_begin <= at_header or at_end <= at_begin:
		return {"error": "the standalone template %s is damaged: it needs the lines %s (first), %s and %s, in that order" % [TEMPLATE_PATH, MARK_HEADER, MARK_BEGIN, MARK_END]}
	var out := PackedStringArray()
	out.append(header)
	for i in range(at_header + 1, at_begin):
		out.append(lines[i])
	out.append(data)
	for i in range(at_end + 1, lines.size()):
		out.append(lines[i])
	return {"source": "\n".join(out)}



## A GDScript literal for a value a suite file can hold: null, a bool, a number, a string, an array or a dictionary
## of those. Anything else (a type JSON cannot carry) becomes its text, as a string. One line, no matter the value.
static func lit(v: Variant) -> String:
	match typeof(v):
		TYPE_NIL:
			return "null"
		TYPE_BOOL:
			return "true" if v else "false"
		TYPE_INT:
			return str(v)
		TYPE_FLOAT:
			return lit_float(v)
		TYPE_STRING, TYPE_STRING_NAME:
			return quote(str(v))
		TYPE_ARRAY:
			var parts := PackedStringArray()
			for e in v:
				parts.append(lit(e))
			return "[" + ", ".join(parts) + "]"
		TYPE_DICTIONARY:
			var kv := PackedStringArray()
			for k in v:
				kv.append("%s: %s" % [quote(str(k)), lit(v[k])])
			return "{" + ", ".join(kv) + "}"
	return quote(str(v))


## A float as a literal that reads back as the same double. JSON.stringify prints the shortest text of up to 15
## digits (what a suite file holds), which is exact for any number that came out of that file; a number built some
## other way gets 17 digits instead. NaN and infinity cannot be in a JSON file; they are spelled as their constants.
static func lit_float(f: float) -> String:
	if is_nan(f):
		return "NAN"
	if is_inf(f):
		return "INF" if f > 0.0 else "-INF"
	var s := JSON.stringify(f)
	if float(s) == f and (s.contains(".") or s.contains("e")):
		return s
	s = String.num(f, 17)
	if float(s) == f and (s.contains(".") or s.contains("e")):
		return s
	return str(f) if (str(f).contains(".") or str(f).contains("e")) else "%s.0" % str(f)


## A string literal: one line, every character that could end it, start a line or confuse a reader escaped. A
## quote and a backslash are escaped; a newline, a carriage return and a tab are written as \n \r \t; any other
## control character, the line and paragraph separators, the C1 controls and the text-direction controls become
## \uXXXX; NUL and a lone surrogate (which a GDScript string cannot hold) become U+FFFD. Everything else, emoji
## included, is kept.
static func quote(s: String) -> String:
	var out := "\""
	for i in s.length():
		var c := s.unicode_at(i)
		if c == 34:
			out += "\\\""
		elif c == 92:
			out += "\\\\"
		elif c == 10:
			out += "\\n"
		elif c == 13:
			out += "\\r"
		elif c == 9:
			out += "\\t"
		elif c == 0 or (c >= 0xD800 and c <= 0xDFFF):
			out += "\\ufffd"
		elif c < 32 or c == 127 or (c >= 0x80 and c < 0xA0) or c == 0x2028 or c == 0x2029 or is_bidi_control(c):
			out += "\\u%04x" % c
		else:
			out += String.chr(c)
	return out + "\""


## The characters that change the direction text is drawn in: the left-to-right and right-to-left marks, the
## embeddings and overrides (U+202A to U+202E) and the isolates (U+2066 to U+2069). GDScript refuses every one of
## them raw inside a string literal ("Invisible text direction control character present in the string, escape
## it"), and Arabic or Hebrew UI text often carries a mark, so a suite that holds one would otherwise make a test
## that does not parse. They are the only characters it refuses (probed on 4.4.1, 4.6.2 and 4.7; a comment may hold
## them, but comment_text drops them too, so a header cannot be drawn as something it is not).
static func is_bidi_control(c: int) -> bool:
	return c == 0x200E or c == 0x200F or (c >= 0x202A and c <= 0x202E) or (c >= 0x2066 and c <= 0x2069)


## A suite's own text, made safe to sit inside a `#` comment: every control character, line separator,
## text-direction control and backslash becomes a space or a slash, so it can neither start a new line of code nor
## continue one nor reorder what a reader sees, and it is cut to `cap` characters.
static func comment_text(s: String, cap: int = COMMENT_MAX) -> String:
	var out := ""
	for i in s.length():
		var c := s.unicode_at(i)
		if c == 92:
			out += "/"
		elif c < 32 or c == 127 or (c >= 0x80 and c < 0xA0) or c == 0x2028 or c == 0x2029 or c == 0xFEFF or (c >= 0xD800 and c <= 0xDFFF) or is_bidi_control(c):
			out += " "
		else:
			out += String.chr(c)
		if out.length() >= cap:
			return out + "..."
	return out
