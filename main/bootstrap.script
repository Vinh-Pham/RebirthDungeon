local monarch = require("monarch.monarch")

local SCREENS = { "title", "characters", "creation", "arrival", "world" }

function init(self)
	for _, screen in ipairs(SCREENS) do
		monarch.register_proxy("playable_" .. screen, msg.url("#nav_" .. screen), {
			others_keep_input_focus_when_below_screen = true,
		})
	end
	self.pending_screen = "title"
	self.current_screen = nil
	print("Rebirth Dungeon Defold bootstrap ready; migrated gameplay starting.")
end

function update(self)
	if self.pending_screen == self.current_screen or monarch.is_busy() then
		return
	end
	local screen = self.pending_screen
	self.current_screen = screen
	monarch.show("playable_" .. screen, { clear = true }, nil, function()
		-- The persistent Flow GUI owns controls across screen collection lifetimes.
		msg.post(".", "release_input_focus")
		msg.post("#ui", "navigation_ready", { screen = screen })
	end)
end

function on_message(self, message_id, message, sender)
	if message_id == hash("navigate") then
		for _, screen in ipairs(SCREENS) do
			if message.screen == screen then
				self.pending_screen = screen
				return
			end
		end
	else
		monarch.on_message(message_id, message, sender)
	end
end

function final(self)
	for _, screen in ipairs(SCREENS) do
		monarch.unregister("playable_" .. screen)
	end
end
